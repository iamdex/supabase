############
# Supabase self-hosted — Dokploy environment
#
# 1. Generate fresh secrets:
#      cd docker && sh utils/generate-keys.sh
#    Copy the printed values into the matching keys below.
# 2. Set SUPABASE_DOMAIN to your real domain (DNS A record -> VPS IP).
# 3. Paste this whole file into the Dokploy "Environment" tab of the
#    Compose service. Do NOT commit real secrets to git.
############

# ---- Public domain (used by Traefik routing + all public URLs) ----
SUPABASE_DOMAIN=supabase.espertini.com

# These three MUST be https://${SUPABASE_DOMAIN}
SUPABASE_PUBLIC_URL=https://supabase.espertini.com
API_EXTERNAL_URL=https://supabase.espertini.com
# Primary app site URL (where users land after auth)
SITE_URL=https://store.espertini.com
# Comma-separated extra redirect URLs allowed after auth (your frontend origins)
ADDITIONAL_REDIRECT_URLS=https://store.espertini.com,https://store.espertini.com/**

############
# Secrets — REPLACE EVERY VALUE (run utils/generate-keys.sh)
############
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=replace-with-generated-anon-key
SERVICE_ROLE_KEY=replace-with-generated-service-role-key
SECRET_KEY_BASE=replace-with-generated-secret-key-base
VAULT_ENC_KEY=replace-with-generated-32-char-key
PG_META_CRYPTO_KEY=replace-with-generated-32-char-key
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-generated-id
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-generated-secret

# Optional new opaque API keys (leave blank to use legacy ANON/SERVICE keys)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# ---- Dashboard (Studio) login — basic auth at the domain root ----
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me-to-a-strong-password

############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Supavisor (pooler)
############
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=your-tenant-id
POOLER_DB_POOL_SIZE=5

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
# Optional — enables Studio AI assistant
OPENAI_API_KEY=

############
# Auth
############
JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
# Set true for testing without a real SMTP server (no confirmation email needed)
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# ---- SMTP (REQUIRED for real email confirmations / password resets) ----
# Use a real provider (Resend, Postmark, SES, Mailgun, etc.) in production.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-smtp-password
SMTP_SENDER_NAME=Supabase

# ---- OAuth providers (optional) ----
# Uncomment matching lines in docker-compose.yml (auth service) to activate.
# GOOGLE_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=
# GITHUB_ENABLED=true
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=

############
# Storage
############
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
# Max upload size in bytes (default 50 MiB)
STORAGE_FILE_SIZE_LIMIT=52428800

############
# Edge Functions
############
FUNCTIONS_VERIFY_JWT=false

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# imgproxy
############
IMGPROXY_AUTO_WEBP=true
